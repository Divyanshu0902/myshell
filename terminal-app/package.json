{
    "name":  "myshell-terminal-app",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Concept A cyberpunk desktop terminal app for myshell",
    "main":  "electron/main.cjs",
    "type":  "module",
    "scripts":  {
                    "dev":  "concurrently -k \"vite\" \"wait-on tcp:5173 \u0026\u0026 cross-env ELECTRON_RENDERER_URL=http://localhost:5173 node scripts/electron-launch.cjs .\"",
                    "build":  "vite build",
                    "build:shell":  "cd ..\\shell-core && gcc -Wall -Wextra -std=c11 myshell.c -o myshell_v6.exe",
                    "dist":  "npm run build && electron-builder",
                    "dist:win":  "npm run build:shell && npm run build && electron-builder --win nsis",
                    "preview":  "vite preview",
                    "start":  "node scripts/electron-launch.cjs ."
                },
    "dependencies":  {
                         "@xterm/addon-fit":  "^0.11.0",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "xterm":  "^5.3.0"
                     },
    "devDependencies":  {
                            "@types/react":  "^18.3.12",
                            "@types/react-dom":  "^18.3.1",
                            "@vitejs/plugin-react":  "^4.3.3",
                            "concurrently":  "^9.0.1",
                            "cross-env":  "^7.0.3",
                            "electron":  "^33.2.1",
                            "electron-builder":  "^25.1.8",
                            "typescript":  "^5.6.3",
                            "vite":  "^5.4.10",
                            "wait-on":  "^8.0.1"
                        },
    "build":  {
                  "appId":  "com.apnashell.desktop",
                  "productName":  "apnaShell",
                  "asar":  true,
                  "files":  [
                               "dist/**/*",
                               "electron/**/*",
                               "scripts/**/*",
                               "package.json"
                           ],
                  "extraResources":  [
                                        {
                                            "from":  "../shell-core/myshell_v6.exe",
                                            "to":  "shell-core/myshell_v6.exe"
                                        }
                                    ],
                  "directories":  {
                                     "output":  "release"
                                 },
                  "win":  {
                             "target":  [
                                           "nsis"
                                       ]
                           },
                  "nsis":  {
                              "oneClick":  false,
                              "allowToChangeInstallationDirectory":  true,
                              "createDesktopShortcut":  true,
                              "createStartMenuShortcut":  true
                          }
                }
}
